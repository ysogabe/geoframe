# ============================================================
# GEOFRAME リポジトリ共通（パス非依存規則）
# ============================================================

# Python / venv（任意パス）
.venv/
__pycache__/
*.pyc

# 秘密情報（絶対にコミットしない。本番はデータ側 /var/lib/geoframe/ に置く）
.env
.env.*
!.env.example
drive_key.json
*.pem
*.p12
*.pfx

# データルート（GEOFRAME_DATA_DIR 既定値 = app/var/）
# catalog.db は Vertex AI 課金済み embedding・手動 GPS 修正・お気に入りを含み
# 再構築不可。バックアップは必ず sqlite3 .backup で取得する（cp 禁止）。
var/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS
.DS_Store

# ツールのセッション成果物（プロジェクトのソースではない）
.claude/
.serena/

# 個人環境の運用メモ（家庭内ホスト名・IP・センサー構成を含む）
local-notes/

# 公開リポジトリには含めないローカル検証コード
local-poc/
app/local-tools/

# Rust（Cargo）
/target/
