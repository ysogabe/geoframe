# ============================================================
# GEOFRAME リポジトリ共通（パス非依存規則）
# ============================================================

# Python / venv（任意パス）
.venv/
__pycache__/
*.pyc

# 秘密情報（絶対にコミットしない。本番はデータ側 /var/lib/geoframe/ に置く）
.env
.env.*
!.env.example
drive_key.json
*.pem
*.p12
*.pfx

# データルート（GEOFRAME_DATA_DIR 既定値 = app/var/）
# catalog.db は Vertex AI 課金済み embedding・手動 GPS 修正・お気に入りを含み
# 再構築不可。バックアップは必ず sqlite3 .backup で取得する（cp 禁止）。
var/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS
.DS_Store

# Swift / macOS app build artifacts
mac-wkwebview/.build/
mac-wkwebview/dist/

# ツールのセッション成果物（プロジェクトのソースではない）
.claude/
.serena/

# 個人環境の運用メモ（家庭内ホスト名・IP・センサー構成を含む）
local-notes/

# 公開リポジトリには含めないローカル検証コード
local-poc/
app/local-tools/

# native-display: ビルド生成物
native-display/build/
native-display/build-*/

# native-display: clangd のインデックスキャッシュ
# （CMAKE_EXPORT_COMPILE_COMMANDS で出る compile_commands.json をエディタが
#   読んで自動生成する。再生成可能なので追跡しない）
native-display/.cache/

# native-display: フォント本体（OFL だがバイナリなので tools/fetch-fonts.sh で取得する）
native-display/assets/fonts/*.ttf
native-display/assets/fonts/*.ttc
native-display/assets/fonts/*.otf

# native-display: フル fixture（実環境の位置メタデータ。件数は Drive 同期で
# 増え続けるため固定値は書かない。コミット版は assets/fixtures/ の座標をぼかした縮小版のみ）
native-display/tests/data/
