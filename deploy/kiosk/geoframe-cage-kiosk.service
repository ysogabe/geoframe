[Unit]
Description=GeoFrame kiosk (cage + Chromium, Wayland)
Documentation=file:///opt/geoframe/deploy/kiosk/README_RPI400.md
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=geoframe
Group=geoframe
SupplementaryGroups=video render input
WorkingDirectory=/opt/geoframe
Environment=HOME=/var/lib/geoframe
Environment=XDG_RUNTIME_DIR=/run/geoframe
EnvironmentFile=-/etc/geoframe/kiosk.env
ExecStart=/opt/geoframe/deploy/kiosk/cage-kiosk.sh
Restart=always
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geoframe-cage

[Install]
WantedBy=multi-user.target
