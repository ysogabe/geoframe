# GeoFrame キオスク（表示専用ノード）設定例
#
# 配置先: /etc/geoframe/kiosk.env
# 使い方: systemd の EnvironmentFile= から読ませる（geoframe-cog.service /
#         geoframe-cage-kiosk.service の両方がこのファイルを見る）
#
# ※サーバーを別機体に置く場合は GEOFRAME_URL をそのIPへ。
#   サーバー側のHost検証は「IPリテラル宛は無条件許可」なので、
#   IPで指定する限りサーバー側の設定変更は不要（ホスト名で指定する場合のみ
#   サーバー側の GEOFRAME_ALLOWED_HOSTS にその名前を足す）。

# --- 表示するURL -------------------------------------------------------------
# 例: http://192.168.0.10:8080/          サーバーが別機体（IP直・設定変更不要）
#     http://localhost:8080/            サーバーが同じ機体
GEOFRAME_URL=http://localhost:8080/

# --- 表示モード -------------------------------------------------------------
# 開発（FHDモニタ）: 1920x1080@60 / 最終（2560x1080 21:9）: 2560x1080@60
COG_PLATFORM_DRM_MODE_MAX=1920x1080@60
# EDIDからnative modeが選ばれない場合のみ（通常は未設定のまま）
#COG_PLATFORM_DRM_VIDEO_MODE=2560x1080

# --- 見た目 -----------------------------------------------------------------
COG_BG_COLOR=#05080fff

# --- 起動時の挙動 -----------------------------------------------------------
# サーバー到達待ちの上限秒。これを過ぎたら OFFLINE_URL があればそこへ切り替える
GEOFRAME_KIOSK_WAIT_TIMEOUT=60
# サーバー断のときに表示するローカル画面（Phase 5。未指定なら空白のまま起動）
#GEOFRAME_KIOSK_OFFLINE_URL=http://127.0.0.1:8099/offline.html

# --- 検証時のみ -------------------------------------------------------------
# マウス操作を許可する場合: COG_EXTRA_ARGS=--platform-params=pointer=true,cursor=true
#COG_EXTRA_ARGS=

# --- cage + Chromium を使う場合（第二候補）----------------------------------
# cage-kiosk.sh 用。Chromium は CDP を持つので負荷測定がしやすい
KIOSK_PROFILE_DIR=/var/lib/geoframe/kiosk-profile
KIOSK_DEBUG_PORT=9222
