[Unit]
Description=GEOFRAME Hermes agent status exporter
After=local-fs.target

[Service]
Type=simple
User=hermes
Group=geoframe-status
UMask=0027
ExecStart=/usr/bin/python3 /opt/geoframe/deploy/agents/hermes-status-exporter.py
RuntimeDirectory=geoframe-agent-status
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=5
NoNewPrivileges=true
# The exporter reads the Hermes heartbeat below the service user's home
# (<HERMES_HOME>/state/gateway.heartbeat, default ~/.hermes). Named profiles
# (<HERMES_HOME>/profiles/<name>/state/gateway.heartbeat) are discovered too, so no
# override is needed when the running profile changes. Pin with HERMES_PROFILE=<name>
# (deterministic when several profiles run at once) or HERMES_HEARTBEAT_FILE=<path>,
# or move the search root with HERMES_HOME.

[Install]
WantedBy=multi-user.target
