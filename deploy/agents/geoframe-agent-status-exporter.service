[Unit]
Description=GEOFRAME Hermes agent status exporter
After=local-fs.target

[Service]
Type=simple
User=hermes
Group=geoframe-status
UMask=0027
ExecStart=/usr/bin/python3 /opt/geoframe/deploy/agents/hermes-status-exporter.py
RuntimeDirectory=geoframe-agent-status
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=5
NoNewPrivileges=true
# The exporter reads the Hermes heartbeat below /home/hermes.

[Install]
WantedBy=multi-user.target
