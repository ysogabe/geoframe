[Unit]
Description=GEOFRAME 書き出し (geoframe-export serve。note 記事用の写真を Google Drive へ書き出す HTTP の入口)
Documentation=file:///opt/geoframe/deploy/README.md

# 配置の手順は deploy/README.md の「note 記事用の写真書き出し（geoframe-export）の配置」。
# 設計は docs/note-photo-export/design.md（unit は 2.6・3.4・8 章）。
#
# この unit は雛形。tailnet の IP・許可する送信元・トークンのファイルの置き場所は、ここに書かず
# /etc/default/geoframe-export に置く（下の「--- 設定 ---」）。

# tailnet の IP に bind するので、起動直後に Tailscale がまだ IP を付けていないと bind に失敗する（終了コード 1）。
# それは下の Restart=on-failure が再試行する。tailscaled.service が無い機体では、この After= は何もしない。
After=network-online.target tailscaled.service
Wants=network-online.target

# 写真サービス（geoframe-rs.service）への依存は、順序（After=）だけにして、Wants=/Requires=/BindsTo= は書かない。
# 書き出しは、写真サービスの一覧 API を 1 つのジョブごとに HTTP で読むだけで、サービスが止まっていれば
# そのジョブが feed_unavailable で失敗するだけ（公開の途中には入らない）。Requires=/BindsTo= にすると、写真サービスを
# 更新・再起動するたびに、実行中の書き出しまで止めてしまう。unit が両方とも有効な機体で、起動と停止の順だけをそろえる。
After=geoframe-rs.service

# Restart=on-failure の再起動の上限。tailnet の IP がまだ無い、状態ディレクトリがまだ使えないなどの一時的な失敗
# （終了コード 1）は 15 秒おきに再試行するが、直らない状態が続くなら 300 秒に 10 回で止める（無限ループにしない）。
# 止まったあとは systemctl reset-failed geoframe-export のあとで起動する。
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# 専用ユーザー（README の手順で作る。ログインシェルもホームも持たない）。写真サービスの geoframe ユーザーとも、
# オーナーのユーザーとも別にする。Drive 全体の権限の rclone の設定は、このユーザーだけが読める（設計 8 章「資格情報」）。
User=geoframe-export

# --- 状態ディレクトリ ---
# /var/lib/geoframe-export を User= の持ち物・0700 で用意する。書けるのはここだけ（下の ProtectSystem=strict）。
#   staging/ … 作業領域（公開の前に一式を作る。成功・失敗にかかわらず消す）
#   jobs/ … ジョブの記録    published/ … 公開の記録    export.lock … 実行枠（flock。CLI と共通）
#   rclone/ … rclone の設定（rclone.conf。専用の client_id で認可したもの）と、rclone の HOME・キャッシュ
# 注意: rclone/rclone.conf が無い（または client_id・client_secret が空）と起動しない（終了コード 2）。そのため、初回の起動の前に
# README の手順で rclone/ と設定を用意する。
StateDirectory=geoframe-export
StateDirectoryMode=0700

# --- 設定 ---
# /etc/default/geoframe-export（0600 root:root。値は文書に書かない。無ければ起動しない）に、次の 3 つの変数を置く。
#   GEOFRAME_EXPORT_LISTEN      tailnet の IP とポート（例: 192.0.2.1:8090。実際は tailnet の帯 100.64.0.0/10 の IP）
#   GEOFRAME_EXPORT_TOKEN_FILE  Bearer トークンのファイルのパス（User= の持ち物・0600・32 バイト以上）
#   GEOFRAME_EXPORT_ALLOW_ARGS  許可する送信元。"--allow 192.0.2.10 --allow 192.0.2.11" の形（呼び出し側とこのホスト自身）
# drop-in（/etc/systemd/system/geoframe-export.service.d/）で ExecStart を上書きする形にはしない:
# geoframe-export-admin.sh（CLI の包み）が、この unit と同じ設定の引数を使う必要があるため。
#
# ExecStart の展開（systemd.service(5)）:
#   ${VAR} … その値 1 つが 1 つの引数になる（空白を含んでもよい）。変数が空・未設定でも、空の引数が 1 つ残る。
#            すると serve の引数の検査（--listen・--token-file）が断り、終了コード 2 になる
#            （2 は下の RestartPreventExitStatus=2 で、再起動ループにしない）。
#   $VAR   … 値を空白で分けて、0 個以上の引数にする。空・未設定なら 0 個。--allow が 1 つも無ければ、serve が断って終了コード 2。
# 下の 4 つ（--rclone・--rclone-config・--state-dir・--feed-base）は雛形に固定で書く。変えるときは、
# geoframe-export-admin.sh の同じ引数も同じ値にそろえる（deploy/geoframe-export-admin-test.sh が、この 2 つの食い違いを検査する）。
# --remote-yamareco・--remote-travel-journal・--work-root・--rclone-*-timeout は既定のまま（書き出し先は今の
# yamareco/・travel-journal/、作業用のフォルダは gdrive:geoframe-export-work。設計 3.5・4.2）。
EnvironmentFile=/etc/default/geoframe-export
ExecStart=/usr/local/bin/geoframe-export serve \
    --listen ${GEOFRAME_EXPORT_LISTEN} \
    --token-file ${GEOFRAME_EXPORT_TOKEN_FILE} \
    $GEOFRAME_EXPORT_ALLOW_ARGS \
    --rclone /usr/local/bin/rclone \
    --rclone-config /var/lib/geoframe-export/rclone/rclone.conf \
    --state-dir /var/lib/geoframe-export \
    --feed-base http://127.0.0.1:8080

# --- 停止 ---
# SIGTERM を受けると、serve は新しい受付を閉じ、接続の処理を最大 75 秒（serve.rs の SHUTDOWN_WAIT）待って打ち切り、
# そのあと実行中のジョブの rclone をプロセスグループごと止めて wait し終えてから、実行枠を手放して終わる（後始末の待ちに
# 期限は無いが、rclone は止まるので有限）。子の rclone の止め方は serve が決めるので、systemd が rclone にも直接 SIGTERM を
# 送って順序を乱さないよう、KillMode=mixed にする（SIGTERM は本体だけ。タイムアウトのあとの SIGKILL は残りの全部）。
KillMode=mixed
# 75 秒の打ち切りと、そのあとの後始末（rclone の停止・待ち）に余裕を足した 180 秒。それでも終わらなければ systemd が SIGKILL する
# （止まったジョブの記録は running のまま残り、次の起動の復旧か recover が片付ける。設計 4.2 の復旧の表）。
TimeoutStopSec=180s

# 異常終了は再起動する。ただし引数・設定の誤り（終了コード 2。トークンのファイルの権限、tailnet でない --listen、
# rclone の設定の不備など）は再起動しても直らないので、再起動ループにせず failed のまま止める。
# bind の失敗・状態ディレクトリが開けないなど（終了コード 1）は再試行に意味があるので再起動対象。
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=2

# 起動の最初に、止まっていたジョブの復旧（Drive の照合。最大で数分）を済ませてから待ち受ける。この間は /healthz も
# 答えず、接続は拒否される（serve.rs）。Type=simple なので、systemd は起動の完了を待たない。

# --- ハードニング（設計 8 章「unit のハードニング」）---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
# 特権（capability）は要らない（1024 以上のポートで待ち受け、自分の状態ディレクトリにだけ書く）。
CapabilityBoundingSet=
# AF_INET・AF_INET6 は、tailnet での待ち受け、写真サービスへの接続（127.0.0.1）、rclone の Google への HTTPS。
# rclone（Go）が AF_UNIX（systemd-resolved・nscd の名前解決など）や AF_NETLINK（ネットワークの構成の読み取り）を要するかは、
# 2026-11-22 の本番での実測（deploy/README.md §8.8）で確かめ済み。AF_INET・AF_INET6 だけで足りた。
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
# 作るファイル（記録・作業領域の写真・rclone の設定）は、所有者だけが読める。geoframe-export-admin.sh も同じ UMask で動かす。
UMask=0077
# 次の 3 つは、2026-11-22 の本番での実測（deploy/README.md §8.8）で決めた。14 日の最多（880 枚・690MB）の書き出し中、
# anon メモリは最大 38.5MB、ページキャッシュは最大 660MB、タスクは最大 24 だった。MemoryMax=256M・TasksMax=64・
# MemoryDenyWriteExecute=true でも成功した。MemoryMax はページキャッシュの回収で詰まらないよう、余裕を見て 512M にした。
MemoryDenyWriteExecute=true
MemoryMax=512M
TasksMax=64
# 書き込める場所は StateDirectory だけで、ReadWritePaths= は足さない。

# ログは journal へ集約（確認: journalctl -u geoframe-export -f）。トークンと要求のヘッダは出さない（設計 3.4）。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geoframe-export

[Install]
WantedBy=multi-user.target
