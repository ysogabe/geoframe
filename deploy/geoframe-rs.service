[Unit]
Description=GEOFRAME server, Rust 版 (geoframe serve, http://localhost:8080/)
Documentation=file:///opt/geoframe/deploy/README.md

# Python 版（geoframe-server.service）と同じ理由で time-sync.target は待たない。
# 時刻のずれは /etc/default/geoframe-rs の TZ で別途担保する。
#
# After=geoframe-server.service は Conflicts= と対で、順序をそろえる。Conflicts= で相手の停止と自分の起動が
# 同じ処理に入ったとき、systemd は順序の向きにかかわらず停止を起動より先に済ませる。これで、どちらの向きで
# 起動しても、旧プロセスが終わってから新しいプロセスが起動する（geoframe-server.service が無い機体では何も起きない）。
After=network-online.target geoframe-server.service
Wants=network-online.target

# 本体は /usr/local/lib/systemd/system/geoframe-rs.service に置く（deploy/rust-deploy.sh が入れる）。
# /etc/systemd/system/ には、systemctl mask のリンク（/dev/null）と drop-in（*.service.d/）だけを置く:
# mask は /etc/systemd/system/<unit> に /dev/null へのリンクを作るので、そこに本体のファイルがあると失敗する。
# Python 版（geoframe-server.service）も同じ置き場所にする。両方を enable したまま再起動したときの衝突を、
# 止める側を mask することで防ぐ（切替の手順は docs/rust-migration/cutover.md）。
#
# Conflicts=: Python 版が起動されたら Rust を止める（Rust を起動したら Python を止める）。取り込みのガード
# （docs/rust-migration/server.md §11.1.1）は Python が止まっていることを起動時に 1 回しか確かめないので、
# その後に geoframe-server.service が systemd 経由で起動されても、二重に書かないようにする。
Conflicts=geoframe-server.service

# Restart=on-failure の再起動の上限。ガードが Python 版の状態を取得できなかったとき（終了コード 1）は、
# systemd がまだ使えない起動直後のような一時的な失敗かもしれないので 5 秒おきに再試行するが、取れない
# 状態が続くなら 120 秒に 5 回で止める（DB が開けないなどの失敗の無限ループも同じ上限で止まる）。
# 止まったあとは systemctl reset-failed geoframe-rs のあとで起動する。
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=geoframe
# バイナリは musl の完全静的ビルド（docs/rust-migration/build.md）。実行時に app/ は読まない
# （管理画面の静的ファイルは埋め込み済み）ので、WorkingDirectory も要らない。
ExecStart=/usr/local/bin/geoframe serve

# StateDirectory=geoframe … /var/lib/geoframe を User=（geoframe:geoframe）に書き込み許可で
# 用意する。Python 版と同じ名前なので、データ置き場は両者で共通になる。
# WAL の DB は読み取りでも同じディレクトリに -shm/-wal を作る・触るので、ディレクトリには
# 書き込み許可が要る（取り込みが無効でも）。
StateDirectory=geoframe
StateDirectoryMode=0750

# --- 設定 ---
# データ置き場（GEOFRAME_DATA_DIR）・Drive の鍵のパス（GEOFRAME_DRIVE_KEY）・TZ・GEOFRAME_INGEST などの
# Rust だけの値は、unit に書かず /etc/default/geoframe-rs に置く（0600 root:root。値は文書に書かない）。
# 中身を読めるのは systemd（root）だけで、サービスと geoframe-admin.sh が同じファイルを読むので、unit と
# すべての CLI が同じ DATA_DIR を指す。撮影時刻はローカル時刻（naive）で比較・表示するので、TZ が無い
# （=UTC）と 9 時間ずれる。Rust 版は TZ を解釈せず libc の localtime に渡すだけなので、設定に必ず TZ を置く。
#
# 先頭の "-" はファイルが無くても起動失敗にしない指定。
#   /etc/default/geoframe     … Python 版と共通の設定（無くてもよい）
#   /etc/default/geoframe-rs  … Rust だけの設定。"-" 無し: 無ければ起動しない（誤った DATA_DIR で空の DB を作らない）
# 優先順位: EnvironmentFile= は、unit の中で書いた順に関係なく Environment= に勝つ（この unit に
# Environment= は無い）。EnvironmentFile= どうしは、指定した順に読み、同じ名前は後のものが勝つ。
# だから geoframe-rs の値が共通のファイルの同名の値を上書きする（ただし同じ名前を両方に置かない）。
# 待ち受けは --listen を書かず、GEOFRAME_HOST/GEOFRAME_PORT（既定 0.0.0.0:8080）で決まる。
# Python 版と同じ機体で並走するときは、README の「Rust 版を Python 版と並走させる」の
# drop-in で --listen を足す（--listen は GEOFRAME_HOST/GEOFRAME_PORT より優先される）。
EnvironmentFile=-/etc/default/geoframe
EnvironmentFile=/etc/default/geoframe-rs

# 停止（SIGTERM）の全体は、受信から 60 秒の共通期限でHTTP・タイル掃除・同期・AI・キャッシュ保存・runtime の停止を
# それぞれ残り時間で打ち切る（docs/rust-migration/server.md §22）。AI のワーカーの join は最大 10 秒。
# 期限のあとにプロセスが終わるまでの余裕を含めて 90 秒待ち、それでも終わらなければ systemd が SIGKILL する
# （残った実行中の AI ジョブは、次の起動が中断として回収する。停止開始が記録されていれば数えない）。
TimeoutStopSec=90s

# 異常終了は再起動する。ただし設定不正（終了コード 2）は再起動しても直らないので、
# 再起動ループにせず failed のまま止める。DB が開けない・スキーマ不足（終了コード 1）は
# Python より先に起動した場合などで再試行に意味があるので再起動対象。
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

# 同時の接続 256 ＋ 配信中のファイル 32 ＋ SQLite ＋ 標準入出力で 300 前後を使う
# （docs/rust-migration/server.md §9.3）。既定の 1024 以上にすること。
LimitNOFILE=4096

# --- ハードニング ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
SystemCallFilter=@system-service
# Rust 版は C 拡張を動的に読み込まず JIT も使わないので、Python 版（Pillow のため付けられない）と
# 違って付けられる。
MemoryDenyWriteExecute=true
# 特権（capability）は要らない（1024 以上のポートで待ち受け、自分のデータ置き場にだけ書く）。
CapabilityBoundingSet=
# AF_UNIX は Python 版の検査（systemctl show。systemd への D-Bus）に要る。AF_INET/AF_INET6 は HTTP と
# 外向きの HTTPS。それ以外（AF_NETLINK など）は使わない。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
PrivateDevices=true
SystemCallArchitectures=native
# 作るファイル（catalog.db の -wal/-shm、.cache.json、derivatives/ など）は、所有者と geoframe グループだけが
# 読める。geoframe-admin.sh も同じ UMask で動かす。
UMask=0027

# 書き込み可能にする範囲は、取り込み用の書き込み接続（writer。docs/rust-migration/server.md §11）が
# 実際に書く分だけ。StateDirectory の中は書けるので、下で ReadOnlyPaths に挙げなかったものが書ける:
#   catalog.db と -wal/-shm … writer（スキーマの移行・索引・位置推定・品質）が書く
#   derivatives/ … 起動時の .dl_* の掃除と、derivative の生成（T2.2〜）
#   tmp/ … Drive 原本の一時ダウンロード先（derivatives/ の外。配信の許可 prefix の外）
#   .cache.json(.tmp) … 地名の永続キャッシュ    .ingest.lock … 取り込みの二重起動を防ぐロック
#   tile_cache/ … 地図タイルのキャッシュ（E11 の取得と、起動時・1 時間ごとの掃除。T3.4）。catalog.db ではない
#     ので、GEOFRAME_INGEST が 0 でも書く・消す（読み取り専用にする photos/ の下には無い）
#   travel_blog/drafts/ … 旅行ブログの下書き（E15。一次データ）    blog_exports/ … 書き出し（E16。作業領域と退避先を含む）
#     どちらも writer が動いているとき（GEOFRAME_INGEST=1）だけ書く。GEOFRAME_INGEST=0 の間は、保存・書き出しの
#     要求は書かずに 503 を返す（docs/rust-migration/server.md §21）
# GEOFRAME_INGEST=1 を設定しない限り（既定は 0）、writer は作られず、catalog.db・derivatives/ には何も書かない
# （上の tile_cache/ は除く）。Python 版と共通の /etc/default/geoframe をそのまま読んでも、Rust は DB に書かない。
# GEOFRAME_INGEST=1 でも、root で実行している・Python 版（geoframe-server）が稼働中だと、書き込みの前に
# 終了コード 2 で断る（状態を取得できないときは 1）（docs/rust-migration/server.md §11.1.1）。
# 終了コード 2 は上の RestartPreventExitStatus=2 により再起動ループにならない。
# 読み取り専用にするもの（先頭の "-" は無いパスを無視する指定。ReadOnlyPaths は
# StateDirectory の書き込み許可より後に効く）:
#   photos/ … ローカル原本。索引は読むだけ（T2.3 の --organize が動かすときに見直す）
#   drive_key.json … Drive のサービスアカウント鍵（GEOFRAME_DRIVE_KEY の既定の置き場）。読むだけ
#   models/ … ローカルのモデル（読むだけ。取り込みは書かない）
# （旅行ブログの travel_blog/・blog_exports/ は T3.6 で外した。上のとおり取り込みが有効なときだけ書く）
ReadOnlyPaths=-/var/lib/geoframe/photos -/var/lib/geoframe/drive_key.json -/var/lib/geoframe/models
# 注意: catalog.db を別の inode に置き換えた（mv で復元した）場合は、再起動するまで古い方を見続ける。
# 復元後は必ず再起動する（docs/rust-migration/server.md §2.4）。

# ログは journal へ集約（確認: journalctl -u geoframe-rs -f）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geoframe-rs

[Install]
WantedBy=multi-user.target
