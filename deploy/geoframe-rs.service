[Unit]
Description=GEOFRAME server, Rust 版 (geoframe serve, http://localhost:8080/)
Documentation=file:///opt/geoframe/deploy/README.md

# Python 版（geoframe-server.service）と同じ理由で time-sync.target は待たない。
# 時刻のずれは下記 Environment=TZ で別途担保する。
After=network-online.target
Wants=network-online.target

# P1〜P4 は検証環境専用で、本番の切替は P5（docs/rust-migration/plan.md）。
# 本番機にはこの unit を入れない。Python 版と同じ待ち受けポート・データ置き場が既定なので、
# 同じ機体で並走させるときは待ち受けとデータ置き場を分ける（deploy/README.md）。
#
# Conflicts= は検証環境だけの安全装置（この unit 自体が検証環境専用）。取り込みのガード
# （docs/rust-migration/server.md §11.1.1）は Python が止まっていることを起動時に 1 回しか確かめない
# ので、その後に geoframe-server.service が起動されても、Rust が書き込み続けて二重に書くことが
# ないよう、systemd に「Python を起動したら Rust を止める（Rust を起動したら Python を止める）」
# 関係を持たせる。geoframe-server.service が無い機体（検証環境）では何も起きない。
# P5 の切替でこの行をどうするかは docs/rust-migration/plan.md P5 の「ガードを外す手順」の 5。
Conflicts=geoframe-server.service

[Service]
Type=simple
User=geoframe
# バイナリは musl の完全静的ビルド（docs/rust-migration/build.md）。実行時に app/ は読まない
# （管理画面の静的ファイルは埋め込み済み）ので、WorkingDirectory も要らない。
ExecStart=/usr/local/bin/geoframe serve

# StateDirectory=geoframe … /var/lib/geoframe を User=（geoframe:geoframe）に書き込み許可で
# 用意する。Python 版と同じ名前なので、データ置き場は両者で共通になる。
# WAL の DB は読み取りでも同じディレクトリに -shm/-wal を作る・触るので、ディレクトリには
# 書き込み許可が要る（取り込みが無効でも）。
StateDirectory=geoframe
StateDirectoryMode=0750

# --- データルート ---
Environment=GEOFRAME_DATA_DIR=/var/lib/geoframe

# Drive のサービスアカウント鍵（T2.4）。Python 版の unit と同じ場所。Rust は相対パスをカレント
# ディレクトリ基準で読むので、unit で絶対パスを与える。鍵が無ければ Drive の段は通信せずに飛ばす。
# GEOFRAME_INGEST が 0（既定）のときは、鍵があっても Drive には接続しない（段が動かない）。
Environment=GEOFRAME_DRIVE_KEY=/var/lib/geoframe/drive_key.json

# 撮影時刻はローカル時刻（naive）で比較・表示する。TZ 未設定（=UTC）だと 9 時間ずれる。
# Rust 版は TZ を解釈せず libc の localtime に渡すだけなので、Python 版と同じく unit で
# 明示する（docs/rust-migration/server.md §1.2）。
Environment=TZ=Asia/Tokyo

# 運用トグル。先頭の "-" はファイルが無くても起動失敗にしない指定。
# Environment=/EnvironmentFile= は記載順に評価され後勝ちなので、上の Environment= より
# 後に置く（/etc/default/geoframe で同名キーを指定すれば意図的に上書きできる）。
# 待ち受けは --listen を書かず、GEOFRAME_HOST/GEOFRAME_PORT（既定 0.0.0.0:8080）で決まる。
# Python 版と同じ機体で並走するときは、README の「Rust 版を Python 版と並走させる」の
# drop-in で --listen を足す（--listen は GEOFRAME_HOST/GEOFRAME_PORT より優先される）。
EnvironmentFile=-/etc/default/geoframe

# 異常終了は再起動する。ただし設定不正（終了コード 2）は再起動しても直らないので、
# 再起動ループにせず failed のまま止める。DB が開けない・スキーマ不足（終了コード 1）は
# Python より先に起動した場合などで再試行に意味があるので再起動対象。
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

# 同時の接続 256 ＋ 配信中のファイル 32 ＋ SQLite ＋ 標準入出力で 300 前後を使う
# （docs/rust-migration/server.md §9.3）。既定の 1024 以上にすること。
LimitNOFILE=4096

# --- ハードニング ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
SystemCallFilter=@system-service
# Rust 版は C 拡張を動的に読み込まず JIT も使わないので、Python 版（Pillow のため付けられない）と
# 違って付けられる。
MemoryDenyWriteExecute=true

# 書き込み可能にする範囲は、取り込み用の書き込み接続（writer。docs/rust-migration/server.md §11）が
# 実際に書く分だけ。StateDirectory の中は書けるので、下で ReadOnlyPaths に挙げなかったものが書ける:
#   catalog.db と -wal/-shm … writer（スキーマの移行・索引・位置推定・品質）が書く
#   derivatives/ … 起動時の .dl_* の掃除と、derivative の生成（T2.2〜）
#   tmp/ … Drive 原本の一時ダウンロード先（derivatives/ の外。配信の許可 prefix の外）
#   .cache.json(.tmp) … 地名の永続キャッシュ    .ingest.lock … 取り込みの二重起動を防ぐロック
#   tile_cache/ … 地図タイルのキャッシュ（E11 の取得と、起動時・1 時間ごとの掃除。T3.4）。catalog.db ではない
#     ので、GEOFRAME_INGEST が 0 でも書く・消す（読み取り専用にする photos/ などの下には無い）
# ただし GEOFRAME_INGEST=1 を設定しない限り（既定は 0）、writer は作られず、catalog.db・derivatives/ には
# 何も書かない（上の tile_cache/ は除く）。P5 の切替まで本番の書き手は Python 版なので、
# /etc/default/geoframe で明示するまで Rust は DB に書かない。
# GEOFRAME_INGEST=1 でも、P5 までは検証環境の印（/etc/geoframe/staging）が無い、または geoframe-server が
# 非稼働と確認できないと、書き込みの前に終了コード 2 で断る（docs/rust-migration/server.md §11.1.1）。
# 終了コード 2 は下の RestartPreventExitStatus=2 により再起動ループにならない。
# 引き続き読み取り専用にするもの（先頭の "-" は無いパスを無視する指定。ReadOnlyPaths は
# StateDirectory の書き込み許可より後に効く）:
#   photos/ … ローカル原本。索引は読むだけ（T2.3 の --organize が動かすときに見直す）
#   blog_exports/・travel_blog/ … 旅行ブログ（P3 で更新 API を足すときに外す）
ReadOnlyPaths=-/var/lib/geoframe/photos -/var/lib/geoframe/blog_exports -/var/lib/geoframe/travel_blog
# 注意: catalog.db を別の inode に置き換えた（mv で復元した）場合は、再起動するまで古い方を見続ける。
# 復元後は必ず再起動する（docs/rust-migration/server.md §2.4）。

# ログは journal へ集約（確認: journalctl -u geoframe-rs -f）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geoframe-rs

[Install]
WantedBy=multi-user.target
