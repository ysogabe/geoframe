  {
   "type": "table",
   "name": "photo_quality",
   "tbl_name": "photo_quality",
   "sql": "CREATE TABLE photo_quality(\n  photo_id INTEGER PRIMARY KEY,\n  display TEXT NOT NULL,\n  source_md5 TEXT,\n  source_mtime REAL,\n  content_sha256 TEXT NOT NULL,\n  group_id INTEGER NOT NULL,\n  group_kind TEXT NOT NULL CHECK(group_kind IN ('exact','similar')),\n  rank_in_group INTEGER NOT NULL,\n  recommended INTEGER NOT NULL CHECK(recommended IN (0,1)),\n  score REAL NOT NULL,\n  reasons_json TEXT NOT NULL DEFAULT '[]',\n  issues_json TEXT NOT NULL DEFAULT '[]',\n  algorithm TEXT NOT NULL,\n  analyzed_at TEXT NOT NULL\n)"
  },
  {
   "type": "index",
   "name": "idx_photo_quality_group",
   "tbl_name": "photo_quality",
   "sql": "CREATE INDEX idx_photo_quality_group ON photo_quality(group_kind, group_id)"
  },
  {
   "type": "table",
   "name": "photo_quality_features",
   "tbl_name": "photo_quality_features",
   "sql": "CREATE TABLE photo_quality_features(\n  photo_id INTEGER PRIMARY KEY,\n  display TEXT NOT NULL,\n  source_md5 TEXT,\n  source_mtime REAL,\n  content_sha256 TEXT,\n  phash TEXT,\n  sharpness REAL,\n  luminance REAL,\n  exposure_score REAL,\n  black_clip REAL,\n  white_clip REAL,\n  contrast REAL,\n  error TEXT NOT NULL DEFAULT '',\n  analyzed_at TEXT NOT NULL\n)"
  },
  {
   "type": "index",
   "name": "idx_photo_quality_features_sha",
   "tbl_name": "photo_quality_features",
   "sql": "CREATE INDEX idx_photo_quality_features_sha\n  ON photo_quality_features(content_sha256)"
  },
  {
   "type": "table",
   "name": "photo_ai_features",
   "tbl_name": "photo_ai_features",
   "sql": "CREATE TABLE photo_ai_features(\n  photo_id INTEGER PRIMARY KEY,\n  display TEXT NOT NULL,\n  source_md5 TEXT,\n  source_mtime REAL,\n  content_sha256 TEXT NOT NULL,\n  embedding_model TEXT NOT NULL,\n  embedding_dim INTEGER NOT NULL,\n  embedding BLOB NOT NULL,\n  subject TEXT NOT NULL DEFAULT '',\n  pet_state TEXT NOT NULL DEFAULT '',\n  eyes TEXT NOT NULL DEFAULT '',\n  face_crop TEXT NOT NULL DEFAULT '',\n  horizon_status TEXT NOT NULL DEFAULT '',\n  horizon_score INTEGER,\n  subject_sharpness INTEGER,\n  aesthetic_score INTEGER,\n  keep_score INTEGER,\n  recommended INTEGER CHECK(recommended IS NULL OR recommended IN (0,1)),\n  reasons_json TEXT NOT NULL DEFAULT '[]',\n  concerns_json TEXT NOT NULL DEFAULT '[]',\n  judge_model TEXT,\n  analyzed_at TEXT NOT NULL,\n  error TEXT NOT NULL DEFAULT ''\n)"
  },
  {
   "type": "index",
   "name": "idx_photo_ai_features_sha",
   "tbl_name": "photo_ai_features",
   "sql": "CREATE INDEX idx_photo_ai_features_sha\n  ON photo_ai_features(content_sha256)"
  },
  {
   "type": "table",
   "name": "photo_embeddings",
   "tbl_name": "photo_embeddings",
   "sql": "CREATE TABLE photo_embeddings(\n  content_sha256 TEXT NOT NULL,\n  embedding_model TEXT NOT NULL,\n  embedding_dim INTEGER NOT NULL,\n  embedding BLOB NOT NULL,\n  analyzed_at TEXT NOT NULL,\n  PRIMARY KEY(content_sha256, embedding_model)\n)"
  },
  {
   "type": "index",
