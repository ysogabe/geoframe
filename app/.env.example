# GEOFRAME の設定例
#
# app/.env へコピーして編集します。ここに挙げていない設定は既定値で動作します。
# 全項目・既定値・用途の一覧は docs/reference/configuration.md を参照してください。
# ※環境変数として直接指定した値は、このファイルより優先されます。
# ※このファイルの値はコミット対象です。実際の鍵やトークンは app/.env 側だけに書きます。

# ------------------------------------------------------------
# 基本
# ------------------------------------------------------------
# データルート（catalog.db・derivatives/・photos/ の置き場。既定は app/var/）
#GEOFRAME_DATA_DIR=/var/lib/geoframe
# 待ち受けポート（既定8080）
#GEOFRAME_PORT=8080
# 待ち受けアドレス。開発時は127.0.0.1へ絞るとこの端末からだけ見える（既定0.0.0.0）
#GEOFRAME_HOST=127.0.0.1
# 追加で許可するHost名（カンマ区切り）。Tailscale名や固定DNS名で開く場合に指定
#GEOFRAME_ALLOWED_HOSTS=geoframe.local:8080

# ------------------------------------------------------------
# Google Driveからの取り込み（任意）
# ------------------------------------------------------------
# サービスアカウント鍵JSONのパス（app/ からの相対。既定 drive_key.json）
#GEOFRAME_DRIVE_KEY=drive_key.json
# 取り込み対象のフォルダ名（既定 GeoFrame）
#GEOFRAME_DRIVE_FOLDER=GeoFrame
# 変更確認の間隔（分。既定10）
#GEOFRAME_DRIVE_POLL_MIN=10

# ------------------------------------------------------------
# AI写真選定・AI検索（任意）
# ------------------------------------------------------------
# 0でAI選定を停止する（既定1）
#GEOFRAME_AI_ENABLED=1
# 1サイクルでembeddingする枚数（既定12）
#GEOFRAME_AI_EMBED_PER_CYCLE=12
# 1サイクルでGemini比較へ回すグループ数（既定2）
#GEOFRAME_AI_JUDGE_PER_CYCLE=2
# 巡回の間隔（秒、最小30。既定60）
#GEOFRAME_AI_POLL_S=60

# ------------------------------------------------------------
# 気象・地理・タイル
# ------------------------------------------------------------
# 気象庁の予報区コード（既定120000=千葉県）
#GEOFRAME_JMA_AREA=120000
# OSMのタイル利用ポリシー対策。連絡先入りの固有UAへ変更しておく
#GEOFRAME_TILE_UA=GeoFrame/0.1 (me@example.com)
# タイルキャッシュ上限（MB。既定16384）
#GEOFRAME_TILE_CACHE_MAX_MB=16384
# 不動産情報ライブラリ APIキー（https://www.reinfolib.mlit.go.jp/help/apiManual/ で申請）
GEOFRAME_MLIT_KEY=

# ------------------------------------------------------------
# 画面の電源制御（任意）
# ------------------------------------------------------------
# 無人在室が続いて画面を消すまでの分数（既定10）
#GEOFRAME_IDLE_MIN=10
# 画面を消すコマンド／戻すコマンド（例: xset dpms force off / xset dpms force on）
#GEOFRAME_SLEEP_CMD=
#GEOFRAME_WAKE_CMD=

# ------------------------------------------------------------
# Home Assistant連携（任意）
# ------------------------------------------------------------
# HomeAssistant Long-Lived Access Token（HA管理画面 > プロフィール から発行）
HOME_ASSISTANT_API_KEY=

# HomeAssistantの接続先URL（未設定時は http://homeassistant.local:8123）
# ※必ずIPアドレスで指定すること。mDNS名(homeassistant.local)のままだと、LAN内の悪意ある
#   機器がmDNS応答レースに勝つだけで、平文HTTPで送られる上記トークンを盗める。
#   そのためサーバー側でも「平文http＋ホスト名」の組み合わせは連携を開始せず警告を出す。
#   HAをHTTPS化している場合は https:// のURLでもよい。
#   下行のIPを自宅のHAのものに書き換えてコメントを外すこと（未設定のままだと連携は始まらない）。
#GEOFRAME_HA_URL=http://192.0.2.10:8123

# HUDに表示する室内環境センサーのentity_id（カンマ区切り、HAの/api/statesで確認）
GEOFRAME_HA_ENV_ENTITIES=

# 在宅判定に使うentity_id（person.xxx 等）
GEOFRAME_HA_MOTION_ENTITY=

# 画面ON/OFF手動オーバーライド用のHome AssistantヘルパーエンティティID（input_select等で作成）
# 未設定時はこの機能全体が無効化され、既存のauto専用の自動スリープロジックのみに
# フォールバックする（後方互換）。
GEOFRAME_HA_SCREEN_MODE_ENTITY=

# HAへの疎通が失敗し続けた場合に、force_on/force_offからautoへ自動的に減衰するまでの時間
# （分、既定値5）
#GEOFRAME_HA_SCREEN_DECAY_MIN=5

# 実機の画面電源状態（on/off）を標準出力で返すコマンド（screen-ctl.sh status相当）。
# GEOFRAME側の意図した状態と実機状態を定期的に照合するために使う。未設定なら照合機能自体が無効。
#GEOFRAME_SCREEN_STATUS_CMD=/opt/geoframe/deploy/kiosk/screen-ctl.sh status

# 上記の照合を実行する間隔（秒、既定値90）
#GEOFRAME_HA_SCREEN_RECONCILE_SEC=90
